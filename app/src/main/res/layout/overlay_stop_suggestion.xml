<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stopSuggestionRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_pill_overlay"
    android:paddingStart="16dp"
    android:paddingEnd="10dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:elevation="24dp">

    <TextView
        android:id="@+id/tvStopSuggestion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Stopped a while — log a stop here?"
        android:textColor="#F1F5F9"
        android:textSize="12sp"
        android:layout_marginEnd="12dp" />

    <Button
        android:id="@+id/btnStopYes"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:text="YES"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:padding="0dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:stateListAnimator="@null"
        android:background="#1D4ED8"
        android:layout_marginEnd="6dp" />

    <Button
        android:id="@+id/btnStopNo"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:text="NO"
        android:textColor="#F1F5F9"
        android:textSize="10sp"
        android:padding="0dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:stateListAnimator="@null"
        android:background="#4A4A4A" />

</LinearLayout>
